<?xml version="1.0" encoding="utf-8"?>
<!--
  QuickShare network security configuration.

  Cleartext is denied. The local Wi-Fi/LAN server used to speak plain HTTP —
  it carries a bearer token from the QR code over the local network — so this
  file had to permit cleartext for a transfer to work at all, and said as much
  rather than pretend otherwise.

  That server now serves HTTPS with a throwaway per-session certificate whose
  fingerprint rides in the QR code and is pinned by the receiver. Trust is
  anchored in the QR, not the network, so there is nothing left that needs
  cleartext and this goes back to refusing it.

  (dart:io's own HTTP stack does not consult this file — it never gated the
  transfer either way — but denying cleartext here keeps any Android-stack
  consumer, a WebView or a plugin, honest, and documents the intent.)
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

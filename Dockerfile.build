# ==============================================================================
# Containerized Multi-stage Build for QuickShare (Linux & Cross-Platform Tools)
# Base Image: Ubuntu 22.04 LTS (Ensures maximum glibc 2.35 compatibility)
# ==============================================================================

FROM ubuntu:22.04 AS linux-builder

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/flutter/bin:${PATH}"

# Install native compilation dependencies, C/C++ toolchain, GTK3 headers
RUN apt-get update && apt-get install -y \
    curl \
    git \
    unzip \
    xz-utils \
    zip \
    clang \
    cmake \
    ninja-build \
    pkg-config \
    libgtk-3-dev \
    liblzma-dev \
    libstdc++-12-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Flutter SDK (Stable channel)
RUN git clone https://github.com/flutter/flutter.git -b stable --depth 1 /flutter \
    && flutter config --enable-linux-desktop \
    && flutter doctor

WORKDIR /app

# Copy application source code
COPY quickshare /app/quickshare

WORKDIR /app/quickshare

# Fetch Dart dependencies
RUN flutter pub get

# Build optimized Linux Release executable with symbol stripping
RUN flutter build linux --release --obfuscate --split-debug-info=build/debug-info

# Prepare Portable Linux Artifact Structure
RUN mkdir -p /app/dist/linux \
    && BUNDLE_DIR="build/linux/x64/release/bundle" \
    && cat << 'EOF' > "$BUNDLE_DIR/QuickShare.AppRun" \
#!/usr/bin/env bash \
HERE="$(dirname "$(readlink -f "$0")")" \
export LD_LIBRARY_PATH="$HERE/lib:$LD_LIBRARY_PATH" \
exec "$HERE/quickshare" "$@" \
EOF \
    && chmod +x "$BUNDLE_DIR/QuickShare.AppRun" \
    && chmod +x "$BUNDLE_DIR/quickshare" \
    && cp -r "$BUNDLE_DIR"/* /app/dist/linux/ \
    && cd /app/dist/linux && tar -czvf /app/dist/quickshare-linux-x64.tar.gz .

CMD ["echo", "Linux build completed successfully. Artifacts ready in /app/dist/linux"]
